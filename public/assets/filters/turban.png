<svg width="200" height="200" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
<defs>
<linearGradient id="turbanGrad1" x1="0%" y1="0%" x2="100%" y2="0%">
<stop offset="0%" style="stop-color:#8B4513;stop-opacity:1" />
<stop offset="50%" style="stop-color:#A0522D;stop-opacity:1" />
<stop offset="100%" style="stop-color:#CD853F;stop-opacity:1" />
</linearGradient>
<linearGradient id="turbanGrad2" x1="0%" y1="0%" x2="100%" y2="0%">
<stop offset="0%" style="stop-color:#A0522D;stop-opacity:1" />
<stop offset="50%" style="stop-color:#CD853F;stop-opacity:1" />
<stop offset="100%" style="stop-color:#DEB887;stop-opacity:1" />
</linearGradient>
<linearGradient id="turbanGrad3" x1="0%" y1="0%" x2="100%" y2="0%">
<stop offset="0%" style="stop-color:#CD853F;stop-opacity:1" />
<stop offset="50%" style="stop-color:#DEB887;stop-opacity:1" />
<stop offset="100%" style="stop-color:#F4A460;stop-opacity:1" />
</linearGradient>
</defs>
<!-- Turban Base Layer -->
<ellipse cx="100" cy="60" rx="80" ry="25" fill="url(#turbanGrad1)" />
<!-- Turban Middle Layer -->
<ellipse cx="100" cy="50" rx="75" ry="20" fill="url(#turbanGrad2)" />
<!-- Turban Top Layer -->
<ellipse cx="100" cy="40" rx="70" ry="18" fill="url(#turbanGrad3)" />
<!-- Decorative Band -->
<ellipse cx="100" cy="35" rx="65" ry="8" fill="#FFD700" />
<!-- Decorative Dots -->
<circle cx="70" cy="35" r="3" fill="#8B4513" />
<circle cx="85" cy="35" r="3" fill="#8B4513" />
<circle cx="100" cy="35" r="3" fill="#8B4513" />
<circle cx="115" cy="35" r="3" fill="#8B4513" />
<circle cx="130" cy="35" r="3" fill="#8B4513" />
<!-- Turban Folds -->
<path d="M40 50 Q60 45 80 50 Q100 55 120 50 Q140 45 160 50" stroke="#8B4513" stroke-width="2" fill="none" opacity="0.6" />
<path d="M45 60 Q65 55 85 60 Q105 65 125 60 Q145 55 165 60" stroke="#8B4513" stroke-width="2" fill="none" opacity="0.4" />
</svg>

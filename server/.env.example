# VirasatRakshak Server Environment Variables Example
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Configuration (Placeholder for future PostgreSQL / Prisma connection)
DATABASE_URL=postgresql://user:password@localhost:5432/virasat_rakshak?schema=public

# Google Gemini AI Key - REQUIRED for AI Story Studio and Heritage Guide Chat
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here

# Gemini Model (optional - defaults to gemini-3.6-flash if not set)
GEMINI_MODEL=gemini-3.6-flash

# Razorpay Payment Credentials (Placeholder)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
